{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "freelyforms-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freelyforms",
      // Placeholder for local development; set the real ID when the database is created.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // ADR 0011: held deliveries; KV deletes each one at its 7-day deadline.
  "kv_namespaces": [{ "binding": "HOLD", "id": "00000000000000000000000000000000" }],
  "queues": {
    "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "freelyforms-delivery" }],
    "consumers": [
      {
        "queue": "freelyforms-delivery",
        // ADR 0001: deliver in batches.
        "max_batch_size": 50,
        "max_batch_timeout": 1,
        "max_retries": 100,
        "dead_letter_queue": "freelyforms-delivery-dlq",
      },
    ],
  },
  // Hourly maintenance: deadlines, expired sessions, pruning.
  "triggers": { "crons": ["17 * * * *"] },
}
