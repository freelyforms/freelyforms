{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freelyforms-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The builder (apps/web) is served by this Worker under /app/ (see src/app.ts).
  "assets": { "directory": "../web/dist/app", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freelyforms",
      // Local development only (wrangler dev uses a local database); production is below.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // ADR 0011: held deliveries; KV deletes each one at its 7-day deadline.
  "kv_namespaces": [{ "binding": "HOLD", "id": "00000000000000000000000000000000" }],
  "queues": {
    "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "freelyforms-delivery" }],
    "consumers": [
      {
        "queue": "freelyforms-delivery",
        // ADR 0001: deliver in batches. 10 keeps one invocation inside the Workers Free limits on
        // Google calls and D1 queries (ADR 0014); raise it on Workers Paid.
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 100,
        "dead_letter_queue": "freelyforms-delivery-dlq",
      },
    ],
  },
  // Submission rate limits (approximate, per Cloudflare location).
  "ratelimits": [
    {
      "name": "SUBMIT_IP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "SUBMIT_FORM_IP_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "vars": {
    // Turnstile test keys that always pass; production sets real keys as secrets.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "ABUSE_EMAIL": "hello@freelyforms.com",
    // ADR 0014: Workers Free limits. On Workers Paid raise both (and the queue's retention).
    "QUEUE_RETENTION_HOURS": "24",
    "GOOGLE_CALL_BUDGET": "40",
  },
  // Hourly maintenance: deadlines, expired sessions, pruning.
  "triggers": { "crons": ["17 * * * *"] },
  // Hosted service: `wrangler deploy --env production` (ADR 0010, ADR 0014). Bindings are not
  // inherited by environments, so they are repeated here with the real resource IDs.
  "env": {
    "production": {
      "name": "freelyforms",
      // Only the custom domains: no workers.dev or preview origin with its own session cookie.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "freelyforms.com", "custom_domain": true },
        { "pattern": "freelyforms.link", "custom_domain": true },
        { "pattern": "www.freelyforms.com", "custom_domain": true },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "freelyforms",
          "database_id": "d31b640e-597b-49a5-8cd2-c84e329f7f5a",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "HOLD", "id": "b23fae6dac624531b1da0da106fa420e" }],
      "queues": {
        "producers": [{ "binding": "DELIVERY_QUEUE", "queue": "freelyforms-delivery" }],
        "consumers": [
          {
            "queue": "freelyforms-delivery",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 100,
            "dead_letter_queue": "freelyforms-delivery-dlq",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "SUBMIT_IP_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "SUBMIT_FORM_IP_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      "vars": {
        "FORMS_HOST": "freelyforms.link",
        "APP_ORIGIN": "https://freelyforms.com",
        "ABUSE_EMAIL": "hello@freelyforms.com",
        "QUEUE_RETENTION_HOURS": "24",
        "GOOGLE_CALL_BUDGET": "40",
        // Public site key of the "Freely Forms public forms" widget (hostname freelyforms.link).
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFYiS9Jl1_JLR9CC",
      },
      // Secrets (wrangler secret put … --env production): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
      // MASTER_KEY_K1, TURNSTILE_SECRET_KEY.
    },
  },
}
