# Copy to .dev.vars for local development (never commit .dev.vars).
# OAuth client: Google Cloud console → Google Auth Platform → Clients → Web application,
# JavaScript origin http://localhost:8787, redirect URI http://localhost:8787/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MASTER_KEY_K1=
# Turnstile test secret that always passes (pairs with the test site key in wrangler.jsonc).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: Google Picker (attach an existing sheet). A browser key from your project restricted to
# the Picker API and http://localhost:8787/*, and your project number.
PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
