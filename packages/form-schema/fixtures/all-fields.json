{
  "schemaVersion": 1,
  "id": "frm_allfields1",
  "title": "Event registration",
  "description": "Every MVP field type in one form.",
  "fields": [
    {
      "id": "fld_name",
      "type": "text",
      "label": "Full name",
      "required": true
    },
    {
      "id": "fld_notes",
      "type": "textarea",
      "label": "Anything we should know?"
    },
    {
      "id": "fld_email",
      "type": "email",
      "label": "Email",
      "required": true
    },
    {
      "id": "fld_phone",
      "type": "phone",
      "label": "Mobile"
    },
    {
      "id": "fld_guests",
      "type": "number",
      "label": "Number of guests",
      "min": 0,
      "max": 10,
      "integer": true
    },
    {
      "id": "fld_date",
      "type": "date",
      "label": "Preferred date",
      "min": "2026-01-01",
      "max": "2026-12-31"
    },
    {
      "id": "fld_page_two",
      "type": "page",
      "label": "About you",
      "description": "A few more details."
    },
    {
      "id": "fld_ticket",
      "type": "select",
      "label": "Ticket",
      "required": true,
      "options": [
        {
          "id": "opt_standard",
          "label": "Standard"
        },
        {
          "id": "opt_vip",
          "label": "VIP"
        }
      ]
    },
    {
      "id": "fld_diet",
      "type": "radio",
      "label": "Dietary requirement",
      "options": [
        {
          "id": "opt_none",
          "label": "None"
        },
        {
          "id": "opt_vegetarian",
          "label": "Vegetarian"
        },
        {
          "id": "opt_vegan",
          "label": "Vegan"
        }
      ]
    },
    {
      "id": "fld_sessions",
      "type": "checkboxes",
      "label": "Sessions",
      "minSelected": 1,
      "maxSelected": 2,
      "options": [
        {
          "id": "opt_morning",
          "label": "Morning"
        },
        {
          "id": "opt_afternoon",
          "label": "Afternoon"
        },
        {
          "id": "opt_evening",
          "label": "Evening"
        }
      ]
    },
    {
      "id": "fld_topics",
      "type": "multiselect",
      "label": "Topics of interest",
      "options": [
        {
          "id": "opt_design",
          "label": "Design"
        },
        {
          "id": "opt_engineering",
          "label": "Engineering"
        }
      ]
    },
    {
      "id": "fld_consent",
      "type": "consent",
      "label": "I agree to the event terms.",
      "required": true
    },
    {
      "id": "fld_utm_source",
      "type": "hidden",
      "label": "UTM source",
      "param": "utm_source",
      "defaultValue": "direct"
    },
    {
      "id": "fld_rating",
      "type": "rating",
      "label": "How was it?"
    },
    {
      "id": "fld_nps",
      "type": "scale",
      "label": "How likely are you to recommend us?",
      "min": 0,
      "max": 10,
      "minLabel": "Not likely",
      "maxLabel": "Very likely"
    },
    {
      "id": "fld_grid",
      "type": "matrix",
      "label": "Rate each",
      "rows": [
        {
          "id": "row_food",
          "label": "Food"
        },
        {
          "id": "row_venue",
          "label": "Venue"
        }
      ],
      "columns": [
        {
          "id": "opt_bad",
          "label": "Bad",
          "score": 0
        },
        {
          "id": "opt_good",
          "label": "Good",
          "score": 2
        }
      ]
    },
    {
      "id": "fld_rank",
      "type": "ranking",
      "label": "Rank the talks",
      "options": [
        {
          "id": "opt_t1",
          "label": "Keynote"
        },
        {
          "id": "opt_t2",
          "label": "Panel"
        },
        {
          "id": "opt_t3",
          "label": "Workshop"
        }
      ]
    },
    {
      "id": "fld_attach",
      "type": "file",
      "label": "Attachments",
      "accept": "documents",
      "maxSizeMb": 5,
      "maxFiles": 2
    },
    {
      "id": "fld_total",
      "type": "calculation",
      "label": "Total score",
      "sum": ["fld_rating", "fld_nps", "fld_grid"],
      "show": true
    }
  ]
}
